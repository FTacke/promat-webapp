# Local operator configuration of the storage roots. Copy to ".env" (git-ignored) in the repository root.
#
# Read only by the intake, preservation, backup and inventory tooling (scripts/research_data_intake/storage_roots.py).
# A variable that is set in the process environment always wins over this file. Only the three names below are
# read; nothing else in a ".env" is used. No value has a default: an unset root is an error for the tool that
# needs it. Use absolute paths. No secrets belong here. See docs/spec/platform-data-files.md, "Storage Roots".

# LOCAL_ARCHIVE: local working archive. The only root intake writes to. Required for intake and archive tooling.
PROMAT_LOCAL_ARCHIVE_ROOT=

# PRESERVATION: verified institutional copy. Written only by "archive_preservation.py copy". Never an intake target.
PROMAT_PRESERVATION_ROOT=

# PHYSICAL_BACKUP: physically separate backup volume. Written only by "archive_preservation.py backup-copy".
# May be offline; app and intake never read it. Must differ from both roots above.
PROMAT_BACKUP_ROOT=
