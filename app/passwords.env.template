# Copy to passwords.env on the target system. Never commit passwords.env.

# Secrets
FLASK_SECRET_KEY=__CHANGE_ME_TO_RANDOM_SECRET_KEY__
JWT_SECRET_KEY=__CHANGE_ME_TO_RANDOM_SECRET_KEY__

# App mode
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_SESSION_SECURE=true
FLASK_SESSION_SAMESITE=lax
JWT_COOKIE_SECURE=true

# Required runtime boundaries inside the production container
PROMAT_RUNTIME_ROOT=/app
PROMAT_PUBLIC_ROOT=/app/public

# Required auth/core database
AUTH_DATABASE_URL=postgresql+psycopg2://promat_app:__POSTGRES_PASSWORD__@db:5432/promat_auth
RATE_LIMIT_STORAGE_URI=redis://rate_limit:6379/0
AUTH_HASH_ALGO=argon2
AUTH_ACCESS_REQUEST_MAIL_ENABLED=true
AUTH_ACCESS_REQUEST_EMAIL=access-requests@example.org
AUTH_ACCESS_REQUEST_SUBJECT=Zugangsanfrage "Pronunciation Matters"
AUTH_ACCESS_REQUEST_FROM_EMAIL=noreply@example.org
AUTH_ACCESS_REQUEST_REPLY_TO_ENABLED=true
AUTH_ACCESS_REQUEST_SMTP_HOST=smtp.example.org
AUTH_ACCESS_REQUEST_SMTP_PORT=587
AUTH_ACCESS_REQUEST_SMTP_USERNAME=
AUTH_ACCESS_REQUEST_SMTP_PASSWORD=
AUTH_ACCESS_REQUEST_SMTP_USE_TLS=true
AUTH_ACCESS_REQUEST_SMTP_USE_SSL=false
AUTH_ACCESS_REQUEST_SMTP_TIMEOUT_SECONDS=10
AUTH_ACCESS_REQUEST_FORM_MAX_AGE_SECONDS=43200
AUTH_ACCESS_REQUEST_MIN_SUBMIT_SECONDS=0.5

# Optional release metadata and bootstrap helpers
APP_REPOSITORY_URL=
APP_RELEASE_TAG=
APP_RELEASE_URL=
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
START_ADMIN_USERNAME=admin
START_ADMIN_PASSWORD=
