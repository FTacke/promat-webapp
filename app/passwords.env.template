# Copy to /srv/webapps/promat/config/passwords.env on the target system.
# Never commit passwords.env or real secret values.

# App mode and public URL
PROMAT_ENV=production
PROMAT_PUBLIC_BASE_URL=__SET_PUBLIC_BASE_URL__
FLASK_DEBUG=false
FLASK_SESSION_SECURE=true
FLASK_SESSION_SAMESITE=lax

# Required runtime boundaries inside the production container
PROMAT_RUNTIME_ROOT=/app
PROMAT_PUBLIC_ROOT=/app/data/public
PROMAT_TEACHING_CONTENT_ROOT=/app/content/teaching

# Secrets
FLASK_SECRET_KEY=__CHANGE_ME__
JWT_SECRET_KEY=__CHANGE_ME__

# PostgreSQL and auth/core database
POSTGRES_DB=__SET_POSTGRES_DB__
POSTGRES_USER=__SET_POSTGRES_USER__
POSTGRES_PASSWORD=__CHANGE_ME__
AUTH_DATABASE_URL=postgresql+psycopg2://__SET_POSTGRES_USER__:__POSTGRES_PASSWORD__@db:5432/__SET_POSTGRES_DB__
RATE_LIMIT_STORAGE_URI=redis://rate_limit:6379/0
AUTH_HASH_ALGO=argon2

# Access-request notification mail
AUTH_ACCESS_REQUEST_MAIL_ENABLED=true
AUTH_ACCESS_REQUEST_EMAIL=__SET_OPERATOR_EMAIL__
AUTH_ACCESS_REQUEST_SUBJECT=__SET_SUBJECT__
AUTH_ACCESS_REQUEST_FROM_EMAIL=__SET_FROM_EMAIL__
AUTH_ACCESS_REQUEST_REPLY_TO_ENABLED=true
AUTH_ACCESS_REQUEST_SMTP_HOST=__SET_SMTP_HOST__
AUTH_ACCESS_REQUEST_SMTP_PORT=587
AUTH_ACCESS_REQUEST_SMTP_USERNAME=
AUTH_ACCESS_REQUEST_SMTP_PASSWORD=
AUTH_ACCESS_REQUEST_SMTP_USE_TLS=true
AUTH_ACCESS_REQUEST_SMTP_USE_SSL=false
AUTH_ACCESS_REQUEST_SMTP_TIMEOUT_SECONDS=10
AUTH_ACCESS_REQUEST_FORM_MAX_AGE_SECONDS=43200
AUTH_ACCESS_REQUEST_MIN_SUBMIT_SECONDS=0.5
