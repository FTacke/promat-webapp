          "metadata_key": "origin_country",
          "future_db_column": "origin_country",
          "type": "string",
          "nullable": true,
          "applies_to": ["native_speaker"]
        },
        {
          "xlsx_column": "origin_region",
          "scope": "person",
          "metadata_key": "origin_region",
          "future_db_column": "origin_region",
          "type": "string",
          "nullable": true,
          "applies_to": ["native_speaker"]
        },
        {
          "xlsx_column": "level_code",
          "scope": "session",
