        {
          "xlsx_column": "mother_l1",
          "scope": "person",
          "metadata_key": "mother_l1",
          "future_db_column": "mother_l1",
          "type": "string",
          "nullable": true,
          "applies_to": ["learner", "native_speaker", "heritage_speaker"]
        },
        {
          "xlsx_column": "father_l1",
          "scope": "person",
          "metadata_key": "father_l1",
          "future_db_column": "father_l1",
          "type": "string",
          "nullable": true,
          "applies_to": ["learner", "native_speaker", "heritage_speaker"]
        },
