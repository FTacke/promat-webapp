        {
          "xlsx_column": "birth_year",
          "scope": "person",
          "metadata_key": "birth_year",
          "future_db_column": "birth_year",
          "type": "integer",
          "nullable": true,
          "applies_to": ["learner", "native_speaker", "heritage_speaker"]
        },
        {
          "xlsx_column": "current_region",
          "scope": "person",
          "metadata_key": "current_region",
          "future_db_column": "current_region",
