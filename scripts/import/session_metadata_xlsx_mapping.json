{
  "workbook_scopes": [
    {
      "worksheet": "sessions",
      "row_grain": "one row per session_id",
      "fields": [
        {
          "xlsx_column": "person_id",
          "scope": "person",
          "metadata_key": "person_id",
          "future_db_column": "person_id",
          "type": "string",
          "nullable": false,
          "applies_to": ["learner", "native_speaker", "heritage_speaker"]
        },
        {
          "xlsx_column": "session_id",
          "scope": "session",
          "metadata_key": "session_id",
          "future_db_column": "session_id",
          "type": "string",
          "nullable": false,
          "applies_to": ["learner", "native_speaker", "heritage_speaker"]
        },
        {
