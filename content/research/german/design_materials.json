  "text": {
    "source": "data/config/research_player/german/task_catalogs/text.json",
    "items": [
      {
        "item_id": "t_01",
        "item_number": "T1",
        "text": "Meine Tochter geht gerne in die Schule."
      },
      {
        "item_id": "t_02",
        "item_number": "T2",
        "text": "Mein Vater mag es, am Abend etwas Warmes zu kochen."
      },
      {
        "item_id": "t_03",
        "item_number": "T3",
        "text": "Im Herbst liegt das bunte Laub auf den Straßen."
      },
      {
        "item_id": "t_04",
        "item_number": "T4",
        "text": "Der Hund und die Gans leben friedlich zusammen."
      },
      {
        "item_id": "t_05",
        "item_number": "T5",
        "text": "Im Frühling scheint die Sonne schon ein bisschen mehr."
      },
      {
        "item_id": "t_06",
        "item_number": "T6",
        "text": "Das Mädchen hat hat eine hübsche neue Tasche."
      },
      {
        "item_id": "t_07",
        "item_number": "T7",
        "text": "Der König wohnte früher in einer mächtigen Burg am Fluss."
      },
      {
        "item_id": "t_08",
        "item_number": "T8",
        "text": "Meine Mutter kauft jeden Morgen Brot beim Bäcker."
      },
      {
        "item_id": "t_09",
        "item_number": "T9",
        "text": "Das Paar sitzt abends ruhig am Feuer."
      },
      {
        "item_id": "t_10",
        "item_number": "T10",
        "text": "Die beiden hören endlich auf, zu streiten."
      },
      {
        "item_id": "t_11",
        "item_number": "T11",
        "text": "Unsere Katze ist sehr lieb, aber trinkt immer aus meiner Tasse."
      },
      {
        "item_id": "t_12",
        "item_number": "T12",
        "text": "Das Boot liegt am Ufer und der Weg dorthin ist nicht weit."
      },
      {
        "item_id": "t_13",
        "item_number": "T13",
        "text": "Die Milch steht auf dem Küchentisch."
      },
      {
        "item_id": "t_14",
        "item_number": "T14",
        "text": "Es riecht überall nach Blüten und Kirschen."
      },
      {
        "item_id": "t_15",
        "item_number": "T15",
        "text": "Sie fährt meistens mit der Bahn zur Arbeit."
      },
      {
        "item_id": "t_16",
        "item_number": "T16",
        "text": "Er isst jeden Abend ein Stück Käse und Butter."
      },
      {
        "item_id": "t_17",
        "item_number": "T17",
        "text": "Nach dem Sturz hatte er Blut an Nase und Lippe."
      },
      {
        "item_id": "t_18",
        "item_number": "T18",
        "text": "Meine Oma liebt ihr Blumenbeet."
      },
      {
        "item_id": "t_19",
        "item_number": "T19",
        "text": "Seine Liebe zur deutschen Sprache ist stark."
      },
      {
        "item_id": "t_20",
        "item_number": "T20",
        "text": "Sie hütet die kleinen Kinder, während die Eltern weg sind."
      },
      {
        "item_id": "t_21",
        "item_number": "T21",
        "text": "Der Kuchen ist noch im Ofen."
      },
      {
        "item_id": "t_22",
        "item_number": "T22",
        "text": "Um acht Uhr beginnt die Vorstellung im Theater."
      },
      {
        "item_id": "t_23",
        "item_number": "T23",
        "text": "Das Geschäft hat noch nicht offen."
      },
      {
        "item_id": "t_24",
        "item_number": "T24",
        "text": "Sie reiten zusammen bis ins Dorf."
      },
      {
        "item_id": "t_25",
        "item_number": "T25",
        "text": "Das neue Gebäude in der Stadtmitte ist wirklich sehr groß."
      },
      {
        "item_id": "t_26",
        "item_number": "T26",
        "text": "Sie fühlen sich heute nicht gut und bleiben zu Hause."
      },
      {
        "item_id": "t_27",
        "item_number": "T27",
        "text": "Ich täusche mich selten, wenn ich ein schlechtes Gefühl bei etwas habe."
      },
      {
        "item_id": "t_28",
        "item_number": "T28",
        "text": "Es ist schon lange ihr Wunsch, auf dem Land zu leben."
      },
      {
        "item_id": "t_29",
        "item_number": "T29",
        "text": "Es waren nur fünf Leute da, aber der Abend war trotzdem sehr schön."
      },
      {
        "item_id": "t_30",
        "item_number": "T30",
        "text": "Die Gabe, anderen gut zuhören zu können, ist sehr wichtig."
      },
      {
        "item_id": "t_31",
        "item_number": "T31",
        "text": "Er arbeitet jeden Tag sehr hart und macht trotzdem niemals Fehler."
      },
      {
        "item_id": "t_32",
        "item_number": "T32",
        "text": "Liest du abends noch ein Buch, bevor du ins Bett gehst?"
      },
      {
        "item_id": "t_33",
        "item_number": "T33",
        "text": "Fahrt ihr auf eurer Reise auch mit dem Zug?"
      },
      {
        "item_id": "t_34",
        "item_number": "T34",
        "text": "Ist das alte Dach noch in gutem Zustand?"
      },
      {
        "item_id": "t_35",
        "item_number": "T35",
        "text": "Fährst du mit dem Rad am Bach entlang?"
      },
      {
        "item_id": "t_36",
        "item_number": "T36",
        "text": "Zeigst du mir heute, wie man Holz sägt?"
      },
      {
        "item_id": "t_37",
        "item_number": "T37",
        "text": "Kannst du bitte die Hinweise am Eingang beachten?"
      },
      {
        "item_id": "t_38",
        "item_number": "T38",
        "text": "Kannst du mir sagen, ob alle aus der Gruppe heute da waren?"
      },
      {
        "item_id": "t_39",
        "item_number": "T39",
        "text": "Weißt du, wie man sich die Hölle früher vorgestellt hat?"
      },
      {
        "item_id": "t_40",
        "item_number": "T40",
        "text": "Machen wir noch ein Spiel zusammen?"
      },
      {
        "item_id": "t_41",
        "item_number": "T41",
        "text": "Treffen wir uns alle morgen um zwölf Uhr in der Bar?"
      },
      {
        "item_id": "t_42",
        "item_number": "T42",
        "text": "Wie tief ist das Wasser hier an dieser Stelle im Fluss?"
      },
      {
        "item_id": "t_43",
        "item_number": "T43",
        "text": "Wer hat das volle Glas auf den Tisch gestellt?"
      },
      {
        "item_id": "t_44",
        "item_number": "T44",
        "text": "Wie viele Sterne kann man nachts über dem See erkennen?"
      },
      {
        "item_id": "t_45",
        "item_number": "T45",
        "text": "Wann besucht ihr eure Tante, die in Berlin wohnt?"
      },
      {
        "item_id": "t_46",
        "item_number": "T46",
        "text": "In wie vielen Fällen stehlen Leute an der Kasse?"
      },
      {
        "item_id": "t_47",
        "item_number": "T47",
        "text": "Was verstehst du unter Leid?"
      },
      {
        "item_id": "t_48",
        "item_number": "T48",
        "text": "Welches Lied singst du am liebsten?"
      },
      {
        "item_id": "t_49",
        "item_number": "T49",
        "text": "Was ist das für ein komisches Ding, das dort in der Ecke steht?"
      },
      {
        "item_id": "t_50",
        "item_number": "T50",
        "text": "Wo genau liegt diese Höhle?"
      },
      {
        "item_id": "t_51",
        "item_number": "T51",
        "text": "Wo ist euer Bad?"
      }
    ]
  }
}
